loki.source.syslog "printer" {
	listener {
		address  = "0.0.0.0:1515"
		protocol = "tcp"
		labels   = { job = "printer", host = "printer" }
	}
	relabel_rules = loki.relabel.syslog.rules
	forward_to    = [loki.write.default.receiver]
}

loki.relabel "syslog" {
	forward_to = []

	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "level"
	}

	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__syslog_message_facility"]
		target_label  = "facility"
	}
}

loki.write "default" {
	endpoint {
		url = "${logs_url}/loki/api/v1/push"

		basic_auth {
			username = "${logs_user_id}"
			password = sys.env("GCLOUD_RW_API_KEY")
		}
	}

	// The source's own labels override these. In a container, set host at the
	// source, unless it uses host networking, because constants.hostname is then
	// the container ID.
	external_labels = {
		"host"         = string.to_lower(constants.hostname),
		"collector_id" = argument.attributes.value["collector.ID"],
		"pipeline"     = "${pipeline}",
	}
}

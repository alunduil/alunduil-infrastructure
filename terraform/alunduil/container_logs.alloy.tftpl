discovery.docker "apps" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "apps" {
	targets = discovery.docker.apps.targets

	// A container's read position is stored under its target's labels. Address
	// and port labels change when a container restarts onto a new IP, and the
	// changed key makes Alloy re-send the container's whole log.
	rule {
		action = "labeldrop"
		regex  = "__address__|__meta_docker_network_.+|__meta_docker_port_.+"
	}

	// TrueNAS runs each app as the Compose project ix-<app>.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "ix-(.*)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "apps" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.apps.output
	labels     = { job = "docker" }
	forward_to = [loki.process.apps.receiver]
}

loki.process "apps" {
	forward_to = [loki.write.default.receiver]

	// Live lines are seconds old. Older ones are history that Alloy re-sends
	// after a container stops, or a silent container's last lines, which it
	// repeats indefinitely.
	stage.drop {
		older_than          = "1h"
		drop_counter_reason = "replayed"
	}

	// The cap stops one chatty app spending the overage budget.
	// loki_process_dropped_lines_by_label_total counts the lines it drops.
	stage.limit {
		rate          = 5
		burst         = 200
		drop          = true
		by_label_name = "app"
	}
}

${loki_write}

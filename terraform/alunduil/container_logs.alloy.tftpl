discovery.docker "apps" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "apps" {
	targets = []

	// TrueNAS runs each app as the Compose project ix-<app>.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "ix-(.*)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "apps" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.apps.targets
	labels        = { job = "docker" }
	relabel_rules = discovery.relabel.apps.rules
	forward_to    = [loki.process.apps.receiver]
}

// The cap stops one chatty app spending the overage budget.
// loki_process_dropped_lines_by_label_total counts the lines it drops.
loki.process "apps" {
	forward_to = [loki.write.default.receiver]

	stage.limit {
		rate          = 5
		burst         = 200
		drop          = true
		by_label_name = "app"
	}
}

${loki_write}

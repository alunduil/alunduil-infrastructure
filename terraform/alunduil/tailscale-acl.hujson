{
	"hosts": {
		// A-01's API answers only on its LAN address, through the truenas
		// subnet route.
		"truenas-lan":   "192.168.68.63",
		"truenas":       "100.98.234.114",
		"homeassistant": "100.84.29.105",
		"nanopi-neo3":   "100.125.212.50",
	},

	"tagOwners": {
		// Terraform plan and apply runners. This tag reaches A-01's API, so give
		// other CI jobs their own.
		"tag:terraform": ["autogroup:admin"],
	},

	"grants": [
		// Excludes tagged devices, which get only the grants naming their tag.
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},

		{"src": ["tag:terraform"], "dst": ["truenas-lan"], "ip": ["tcp:443"]},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"tests": [
		{
			"src":    "tag:terraform",
			"accept": ["truenas-lan:443"],
			"deny": [
				"truenas-lan:80",
				"truenas-lan:445",
				"truenas:443",
				"homeassistant:8123",
				"nanopi-neo3:22",
			],
		},
	],
}

{
	"hosts": {
		// A-01's API listens here, not on A-01's tailnet address, so a node
		// reaches it through the truenas subnet route.
		"truenas-lan":   "192.168.68.63",
		"truenas":       "100.98.234.114",
		"homeassistant": "100.84.29.105",
		"nanopi-neo3":   "100.125.212.50",
	},

	"tagOwners": {
		// Ephemeral runners for the Terraform plan and apply workflows. The tag
		// grants A-01's API, so other CI jobs take a tag of their own.
		"tag:terraform": ["autogroup:admin"],
	},

	"grants": [
		// Tagged devices hold no user identity, so they fall outside
		// autogroup:member and get only the grants naming their tag.
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},

		{"src": ["tag:terraform"], "dst": ["truenas-lan"], "ip": ["tcp:443"]},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"tests": [
		{
			"src":    "tag:terraform",
			"accept": ["truenas-lan:443"],
			"deny": [
				"truenas-lan:80",
				"truenas-lan:445",
				"truenas:443",
				"homeassistant:8123",
				"nanopi-neo3:22",
			],
		},
	],
}

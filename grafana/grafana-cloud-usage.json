{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "grafana-cloud-usage"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Is this month on track for the 12 USD overage budget, and if not, what changed? The links lead to Grafana's own detail.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 1,
          "links": [],
          "title": "",
          "vizConfig": {
            "group": "text",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "**Over 12 USD at month end:** file an issue to find and fix the source. **Under:** no optimisation needed, even if an alert fired during the month.",
                "mode": "markdown"
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "grafanacloud_org_total_overage / 12",
                        "legendFormat": "Budget used",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Month-to-date overage across every product and stack in the organization, as a share of the 12 USD budget. Metrics bill at the month's 95th percentile, so a short early spike falls out as the month goes on.",
          "id": 2,
          "links": [],
          "title": "Budget used this month",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "orange",
                        "value": 0.8
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  },
                  "unit": "percentunit"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "(clamp_min(clamp_max(grafanacloud_org_metrics_billable_series, scalar(max(quantile_over_time(0.95, (grafanacloud_instance_samples_per_second * 60)[7d:5m])))) - grafanacloud_org_metrics_included_series, 0) * 0.0065 + on (org_id) (grafanacloud_org_total_overage - grafanacloud_org_metrics_overage)) and on () (day_of_month() > 10)",
                        "legendFormat": "Projected",
                        "range": false,
                        "instant": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Month-end overage if the last 7 days continue: the lower of this month's billable series and the last 7 days' 95th percentile DPM, at 6.50 USD per 1,000 above included, plus other products' overage so far. Excludes the 19 USD base plan. Hidden until the 11th, because it's unreliable before then. Can't foresee a regression. Assumes DPM sets the bill, not active series.",
          "id": 3,
          "links": [],
          "title": "Projected overage",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 2,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "orange",
                        "value": 9.600000000000001
                      },
                      {
                        "color": "red",
                        "value": 12
                      }
                    ]
                  },
                  "unit": "currencyUSD",
                  "noValue": "Too early (before the 11th)"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Current state of the budget and anomaly alerts. Manage them in Terraform, and see them on the Usage Alerts tab.",
          "id": 4,
          "links": [],
          "title": "Usage alerts",
          "vizConfig": {
            "group": "alertlist",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "alertInstanceLabelFilter": "",
                "alertName": "",
                "dashboardAlerts": false,
                "folder": {
                  "title": "Usage Alerts",
                  "uid": "grafana-cmab-usage-alerts"
                },
                "groupBy": [],
                "groupMode": "default",
                "maxItems": 10,
                "showInstances": false,
                "sortOrder": 1,
                "stateFilter": {
                  "error": true,
                  "firing": true,
                  "noData": false,
                  "normal": true,
                  "pending": true
                },
                "viewMode": "list"
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "(grafanacloud_org_total_overage offset -1d) and on () (day_of_month(vector(time() + 86400)) == 1)",
                        "legendFormat": "Overage",
                        "range": true,
                        "interval": "1d"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "kind": "convertFieldType",
                  "spec": {
                    "id": "convertFieldType",
                    "options": {
                      "conversions": [
                        {
                          "dateFormat": "MMM YYYY",
                          "destinationType": "string",
                          "targetField": "Time"
                        }
                      ],
                      "fields": {}
                    }
                  }
                }
              ]
            }
          },
          "description": "Overage as each month closed, from the usage metric, against the budget. Invoices differ by cents: 118.25 USD billed for September, 9.37 USD for October. The dashboard's time range sets how many months appear.",
          "id": 5,
          "links": [],
          "title": "Month-end overage (approximate)",
          "vizConfig": {
            "group": "barchart",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "axisGridShow": false,
                    "fillOpacity": 80,
                    "lineWidth": 0,
                    "thresholdsStyle": {
                      "mode": "line"
                    }
                  },
                  "decimals": 2,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "orange",
                        "value": 9.600000000000001
                      },
                      {
                        "color": "red",
                        "value": 12
                      }
                    ]
                  },
                  "unit": "currencyUSD"
                },
                "overrides": []
              },
              "options": {
                "barWidth": 0.6,
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false
                },
                "orientation": "auto",
                "showValue": "always",
                "stacking": "none",
                "tooltip": {
                  "mode": "single",
                  "sort": "none"
                },
                "xField": "Time"
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "grafanacloud_org_total_overage",
                        "legendFormat": "Month to date",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "(clamp_min(clamp_max(grafanacloud_org_metrics_billable_series, scalar(max(quantile_over_time(0.95, (grafanacloud_instance_samples_per_second * 60)[7d:5m])))) - grafanacloud_org_metrics_included_series, 0) * 0.0065 + on (org_id) (grafanacloud_org_total_overage - grafanacloud_org_metrics_overage)) and on () (day_of_month() > 10)",
                        "legendFormat": "Projected",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "vector(12)",
                        "legendFormat": "Budget",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "C"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "vector(9.600000000000001)",
                        "legendFormat": "80% of budget",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "D"
                  }
                }
              ],
              "queryOptions": {
                "timeFrom": "now/M"
              },
              "transformations": []
            }
          },
          "description": "Month to date and the month-end projection against the budget, for the current month whatever the dashboard's time range. The projection starts on the 11th.",
          "id": 6,
          "links": [],
          "title": "This month's overage",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    },
                    "axisGridShow": false
                  },
                  "unit": "currencyUSD",
                  "min": 0
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Month to date"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "#d8d9da"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Projected"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "blue"
                        }
                      },
                      {
                        "id": "custom.lineStyle",
                        "value": {
                          "fill": "dash",
                          "dash": [
                            6,
                            4
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Budget"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "red"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "80% of budget"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "orange"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "width": 190,
                  "sortBy": "Last *",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "label_replace(count by (job) ({__name__=~\".+\", job!~\"<aggregated>|\"}), \"job\", \"$1\", \"job\", \"integrations/(.*)\")",
                        "legendFormat": "{{job}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "What changed: stored series on a log axis, aggregated ones included. A new metric family shows as a step. Read it against samples per minute on the Billing/Usage dashboard.",
          "id": 7,
          "links": [],
          "title": "Series by job",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    },
                    "scaleDistribution": {
                      "type": "log",
                      "log": 10
                    },
                    "axisGridShow": false
                  },
                  "unit": "short",
                  "color": {
                    "mode": "palette-classic-by-name"
                  }
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "right",
                  "showLegend": true,
                  "width": 120,
                  "sortBy": "Last *",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "label_replace(avg by (job) (count_over_time(up[5m])) / 5, \"job\", \"$1\", \"job\", \"integrations/(.*)\")",
                        "legendFormat": "{{job}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "What changed: measured from each job's up series, so a faster scrape shows as a step up. Short dips are missed scrapes.",
          "id": 8,
          "links": [],
          "title": "Scrapes per minute by job",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    },
                    "lineInterpolation": "stepAfter",
                    "axisGridShow": false
                  },
                  "unit": "none",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic-by-name"
                  }
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "right",
                  "showLegend": true,
                  "width": 120,
                  "sortBy": "Last *",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "quantile_over_time(0.5, ((sum(grafanacloud_instance_aggregation_raw_samples_total:rate5m) - sum(grafanacloud_instance_aggregation_aggregated_samples_total:rate5m)) * 60)[7d:1h])",
                        "legendFormat": "Samples/min avoided",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Before aggregation minus after, across every rule, manual or recommended. Read a fall against overage: alongside rising overage it means a rule stopped working; alongside flat overage it means fewer samples arrived at all.",
          "id": 9,
          "links": [],
          "title": "Samples/min avoided (7-day median)",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    },
                    "axisGridShow": false
                  },
                  "unit": "short",
                  "min": 0
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": false,
                  "width": 190,
                  "sortBy": "Last *",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "quantile_over_time(0.5, ((sum(grafanacloud_instance_aggregation_raw_samples_total:rate5m) - sum(grafanacloud_instance_aggregation_aggregated_samples_total:rate5m)) * 60)[7d:1h]) * 0.0065",
                        "legendFormat": "Saving",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Samples per minute avoided by aggregation, priced at 6.50 USD per 1,000, using the 7-day median because the raw metric is erratic. An order-of-magnitude estimate. Excludes samples dropped before they reach Grafana, such as Alloy keep lists.",
          "id": 10,
          "links": [],
          "title": "Saving/month",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": null
                      }
                    ]
                  },
                  "unit": "currencyUSD"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },

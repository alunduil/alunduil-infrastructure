{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "delivery-metrics"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "DORA metrics over a rolling 30 days, per docs/reference/delivery-metrics.md. Recording rules in terraform/alunduil/delivery_metrics.tf compute them hourly; each point is the 30 days before it.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum(delivery_deploys{repository=~\"$repository\"}) * 7 / 30",
                        "legendFormat": "Deployment frequency",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Your deploys per week, successful or failed.",
          "id": 1,
          "links": [],
          "title": "Deployment frequency",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 1,
                  "unit": "suffix: /week"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "histogram_quantile(0.5, sum by (le) (delivery_lead_time_seconds_bucket{repository=~\"$repository\"}))",
                        "legendFormat": "Lead time for changes",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Median time from opening a PR to its first successful deploy. Pooled across the selection from histogram buckets, so it interpolates; the table below has each repository's exact median.",
          "id": 2,
          "links": [],
          "title": "Lead time for changes",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "s"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum(delivery_deploys{repository=~\"$repository\", outcome=\"failed\"}) / (sum(delivery_deploys{repository=~\"$repository\"}) > 0)",
                        "legendFormat": "Change failure rate",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Share of your deploys that failed: the deploy run failed, or a later PR reverted a PR it shipped.",
          "id": 3,
          "links": [],
          "title": "Change failure rate",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 0,
                  "max": 1,
                  "min": 0,
                  "unit": "percentunit"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "histogram_quantile(0.5, sum by (le) (delivery_recovery_time_seconds_bucket{repository=~\"$repository\"}))",
                        "legendFormat": "Failed deployment recovery time",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Median time from a failed deploy to the deploy that recovered it. Pooled across the selection from histogram buckets, so it interpolates; the table below has each repository's exact median.",
          "id": 4,
          "links": [],
          "title": "Failed deployment recovery time",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "s"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (repository) (delivery_deploys{repository=~\"$repository\"}) * 7 / 30",
                        "format": "table",
                        "instant": true,
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (repository) (delivery_lead_time_median_seconds{repository=~\"$repository\"})",
                        "format": "table",
                        "instant": true,
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (repository) (delivery_deploys{repository=~\"$repository\", outcome=\"failed\"}) / (sum by (repository) (delivery_deploys{repository=~\"$repository\"}) > 0)",
                        "format": "table",
                        "instant": true,
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "C"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (repository) (delivery_recovery_time_median_seconds{repository=~\"$repository\"})",
                        "format": "table",
                        "instant": true,
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "D"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "kind": "merge",
                  "spec": {
                    "id": "merge",
                    "options": {}
                  }
                },
                {
                  "kind": "organize",
                  "spec": {
                    "id": "organize",
                    "options": {
                      "excludeByName": {
                        "Time": true
                      },
                      "renameByName": {
                        "Value #A": "Deployment frequency",
                        "Value #B": "Lead time for changes",
                        "Value #C": "Change failure rate",
                        "Value #D": "Failed deployment recovery time",
                        "repository": "Repository"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "Each repository's metrics over the last 30 days. Medians are exact. A blank cell means the window had nothing to measure.",
          "id": 5,
          "links": [],
          "title": "Per repository",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Deployment frequency"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "suffix: /week"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Lead time for changes"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "s"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Change failure rate"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "percentunit"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Failed deployment recovery time"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "s"
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "Repository"
                  }
                ]
              }
            },
            "version": "13.3.0"
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              },
              "height": 5,
              "width": 6,
              "x": 0,
              "y": 0
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-2"
              },
              "height": 5,
              "width": 6,
              "x": 6,
              "y": 0
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-3"
              },
              "height": 5,
              "width": 6,
              "x": 12,
              "y": 0
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-4"
              },
              "height": 5,
              "width": 6,
              "x": 18,
              "y": 0
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-5"
              },
              "height": 10,
              "width": 24,
              "x": 0,
              "y": 5
            }
          }
        ]
      }
    },
    "links": [
      {
        "asDropdown": false,
        "icon": "doc",
        "includeVars": false,
        "keepTime": false,
        "tags": [],
        "targetBlank": true,
        "title": "Metric definitions",
        "tooltip": "docs/reference/delivery-metrics.md",
        "type": "link",
        "url": "https://github.com/alunduil/alunduil-infrastructure/blob/main/docs/reference/delivery-metrics.md"
      }
    ],
    "liveNow": false,
    "preferences": {
      "layout": {
        "kind": "GridLayout",
        "spec": {
          "items": []
        }
      }
    },
    "preload": false,
    "tags": [
      "dora",
      "delivery"
    ],
    "timeSettings": {
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-30d",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "title": "Delivery Metrics",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "allValue": ".*",
          "allowCustomValue": false,
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "definition": "label_values(delivery_deploys, repository)",
          "description": "Repositories to pool. Counts and the change failure rate pool exactly; the two medians interpolate from histogram buckets.",
          "hide": "dontHide",
          "includeAll": true,
          "label": "Repository",
          "multi": true,
          "name": "repository",
          "options": [],
          "query": {
            "datasource": {
              "name": "grafanacloud-prom"
            },
            "group": "prometheus",
            "kind": "DataQuery",
            "spec": {
              "qryType": 1,
              "query": "label_values(delivery_deploys, repository)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "skipUrlSync": false,
          "sort": "alphabeticalAsc"
        }
      }
    ]
  }
}

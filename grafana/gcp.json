{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "gcp"
  },
  "spec": {
    "annotations": {
      "list": []
    },
    "description": "Cloud Monitoring signals for the alunduil GCP project: the Terraform state buckets, Google API traffic and errors, and the Data Access audit trail.",
    "editable": true,
    "graphTooltip": 1,
    "links": [],
    "panels": [
      {
        "datasource": {
          "type": "stackdriver",
          "uid": "gcp-cloud-monitoring"
        },
        "description": "Non-2xx responses from every Google API this project calls, summed over the dashboard range. Empty means no API call failed.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "percentChangeColorMode": "standard",
          "reduceOptions": {
            "calcs": [
              "sum"
            ],
            "fields": "",
            "values": false
          },
          "showPercentChange": false,
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "aliasBy": "",
            "datasource": {
              "type": "stackdriver",
              "uid": "gcp-cloud-monitoring"
            },
            "queryType": "timeSeriesList",
            "refId": "A",
            "timeSeriesList": {
              "alignmentPeriod": "cloud-monitoring-auto",
              "crossSeriesReducer": "REDUCE_SUM",
              "filters": [
                "metric.type",
                "=",
                "serviceruntime.googleapis.com/api/request_count",
                "AND",
                "metric.label.response_code_class",
                "!=",
                "2xx"
              ],
              "groupBys": [],
              "perSeriesAligner": "ALIGN_DELTA",
              "projectName": "alunduil"
            }
          }
        ],
        "title": "API errors",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "stackdriver",
          "uid": "gcp-cloud-monitoring"
        },
        "description": "Cloud Storage API requests that did not return OK, summed over the dashboard range. PERMISSION_DENIED here usually means an identity lost a bucket grant.",

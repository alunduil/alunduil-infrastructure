{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alunduil/renovate-config",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Renovate leaves the paired sha256 alone, so a bump fails its checksum until someone refreshes it",
      "managerFilePatterns": ["/^scripts/install-.*\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_VERSION=\"(?<currentValue>.+?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Without a version, mise-action and the mise feature each install the newest mise on their own schedule, so one dependency keeps both pins in a single pull request",
      "managerFilePatterns": [
        "/^\\.github/actions/mise/action\\.yml$/",
        "/^\\.devcontainer/devcontainer\\.json$/"
      ],
      "matchStrings": [
        "\\n\\s+version: '(?<currentValue>[^']+)'",
        "\"ghcr\\.io/devcontainers-extra/features/mise:\\d+\": \\{\\s*\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "mise",
      "packageNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "prek-action's prek-version and mise.toml pin the same prek, so one pull request bumps both",
      "matchDepNames": ["prek"],
      "groupName": "prek"
    },
    {
      "description": "Provider and Terraform updates change every later plan, bootstrap's included",
      "matchManagers": ["terraform"],
      "automerge": false
    },
    {
      "description": "Merging a change to any of terraform-apply.yml's paths applies it. One matching file holds the whole pull request, because Renovate automerges a branch only when every upgrade in it qualifies. Keep in step with terraform-apply.yml's paths",
      "matchFileNames": [
        "terraform/alunduil/**",
        "terraform/modules/**",
        ".github/workflows/terraform-apply.yml",
        ".github/actions/terraform-providers/**",
        ".github/actions/mise/**",
        "scripts/export-terraform-credentials.sh",
        "mise.toml",
        "mise.lock"
      ],
      "automerge": false
    }
  ]
}

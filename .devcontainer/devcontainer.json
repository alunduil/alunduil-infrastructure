{
  "name": "alunduil-infrastructure",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.14-ubuntu@sha256:e15941f70f26542ef9b0ef4bb64f88b8ecdfe8c3372e730ab6e405792805e742",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {
      "version": "2026.11.9"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    }
  },
  "containerEnv": {
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/home/vscode/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "postCreateCommand": "mise install"
}

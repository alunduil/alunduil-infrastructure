{
  "name": "alunduil-infrastructure",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.10-ubuntu@sha256:91eff046d5c12318fc98e59258982b87ba896c467427ed8b5dab5a02107a5db7",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
